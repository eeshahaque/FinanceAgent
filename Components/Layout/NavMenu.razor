@using System.Security.Claims

<nav class="nav-panel" aria-label="Main">
    <a class="brand" href="">
        <Logo />
    </a>

    <AuthorizeView>
        <Authorized>
            <ul class="nav-list" onclick="document.getElementById('nav-toggle').checked = false">
                @foreach (var item in Items)
                {
                    <li>
                        <NavLink class="nav-item" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            <Icon Name="@item.Icon" />
                            <span>@item.Label</span>
                        </NavLink>
                    </li>
                }
            </ul>

            <div class="nav-foot">
                <div class="user-card">
                    <span class="avatar" aria-hidden="true">@Initials(context.User)</span>
                    <span class="user-text">
                        <span class="user-name">@context.User.Identity?.Name</span>
                        <span class="user-role">Personal workspace</span>
                    </span>
                </div>
                <form action="account/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-item logout">
                        <Icon Name="logout" />
                        <span>Log out</span>
                        <Icon Name="chevron-right" Size="16" Class="ms-auto" />
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private record Item(string Href, string Label, string Icon);

    private static readonly Item[] Items =
    {
        new("", "Dashboard", "dashboard"),
        new("transactions", "Transactions", "transactions"),
        new("categories", "Categories", "tag"),
        new("budgets", "Budgets", "pie"),
        new("import", "Import", "upload"),
        new("activity", "Agent Activity", "activity"),
    };

    internal static string Initials(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name ?? "?";
        var parts = name.Split(new[] { '.', '_', '-', ' ', '@' }, StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : name[..Math.Min(2, name.Length)];
        return initials.ToUpperInvariant();
    }
}
