<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FinanceAgent</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="transactions">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transactions
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="categories">
                        <span class="bi bi-tags-nav-menu" aria-hidden="true"></span> Categories
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="budgets">
                        <span class="bi bi-pie-nav-menu" aria-hidden="true"></span> Budgets
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="import">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Import
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="activity">
                        <span class="bi bi-activity-nav-menu" aria-hidden="true"></span> Agent Activity
                    </NavLink>
                </div>
                <div class="nav-item px-3 nav-user">
                    <div class="small text-white-50 px-2 mb-1">Signed in as <strong class="text-white">@context.User.Identity?.Name</strong></div>
                    <form action="account/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-logout-nav-menu" aria-hidden="true"></span> Log out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/login">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Log in
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/register">
                        <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span> Create account
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
