@* FinanceAgent mark: a rising ledger line inside a rounded tile *@
<span class="logo">
    <svg class="logo-mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="logo-fill" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#9b8bff" />
                <stop offset="1" stop-color="#4f6bff" />
            </linearGradient>
        </defs>
        <rect width="34" height="34" rx="10" fill="url(#logo-fill)" />
        <path d="M8 23.5h18" stroke="rgba(255,255,255,.45)" stroke-width="1.6" stroke-linecap="round" />
        <path d="M8.5 19.5 13.5 14.5l4 3.5 8-8" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="25.5" cy="10" r="2.2" fill="#fff" />
    </svg>
    <span class="logo-word">FinanceAgent</span>
</span>
