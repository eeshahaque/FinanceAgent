@page "/activity"
@rendermode InteractiveServer
@inject FinanceQueryService Queries

<PageTitle>Agent Activity</PageTitle>

<h1>Agent Activity</h1>
<p class="text-muted">Every decision an agent made, and why. Useful for auditing what changed in your data.</p>

<div class="d-flex gap-2 mb-3">
    <select class="form-select w-auto" value="@agent" @onchange="async e => { agent = e.Value?.ToString(); await LoadAsync(); }">
        <option value="">All agents</option>
        @foreach (var name in AgentNames)
        {
            <option value="@name">@name</option>
        }
    </select>
</div>

<div class="table-responsive">
    <table class="table table-sm">
        <thead>
            <tr><th>When (UTC)</th><th>Agent</th><th>Action</th><th>Input</th><th>Output</th><th>Reasoning</th></tr>
        </thead>
        <tbody>
            @foreach (var a in actions)
            {
                <tr>
                    <td class="text-nowrap small">@a.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@a.AgentName</td>
                    <td><span class="badge text-bg-light">@a.ActionType</span></td>
                    <td class="small">@a.Input</td>
                    <td class="small">@a.Output</td>
                    <td class="small text-muted">@a.Reasoning</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static readonly string[] AgentNames =
    {
        nameof(RuleBasedCategorizer), nameof(AnomalyDetectionAgent),
        nameof(BudgetAdvisorAgent), "User"
    };

    private List<AgentAction> actions = new();
    private string? agent;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => actions = await Queries.GetAgentActionsAsync(agent, 300);
}
