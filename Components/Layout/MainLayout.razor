@inherits LayoutComponentBase

<div class="shell">
    @* CSS-only toggle so the menu works on phones before (and without) the interactive circuit *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" tabindex="-1" />
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>

    <div class="main">
        <TopBar />
        <main class="content" id="main">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    Something went wrong.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" aria-label="Dismiss"><Icon Name="x" Size="16" /></a>
</div>
